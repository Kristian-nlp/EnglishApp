# ---------------------------------------------------------------------------
# English Tutor — environment variables (spec section 2)
# Copy to .env.local and fill in. NEVER commit real values (NFR-305).
# No secret here may ever reach the client bundle. Only NEXT_PUBLIC_* is
# exposed to the browser, and none of these are prefixed that way.
# ---------------------------------------------------------------------------

# --- Database (Postgres on Neon or Supabase) ---
# App MUST use the pooled endpoint (NFR-105).
DATABASE_URL="postgres://user:pass@host-pooler.example.com/db?sslmode=require"
# Migrations use the direct/unpooled endpoint.
DATABASE_URL_UNPOOLED="postgres://user:pass@host.example.com/db?sslmode=require"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- OpenAI (LLM + TTS + Whisper STT) ---
OPENAI_API_KEY=""

# --- Email (Resend: magic links + reminders) ---
RESEND_API_KEY=""
# Optional (not a secret). Must be a verified Resend domain in production.
AUTH_EMAIL_FROM="English Tutor <onboarding@resend.dev>"

# --- Rate limiting & cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Blob storage (Vercel Blob: TTS audio cache only) ---
BLOB_READ_WRITE_TOKEN=""

# --- Cron protection (NFR-304) ---
CRON_SECRET=""

# --- Azure Speech Pronunciation Assessment (phase 7) ---
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
